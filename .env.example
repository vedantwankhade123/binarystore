VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
# Server scripts only; NEVER prefix this variable with VITE_.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/server-only-service-account.json

# Server-only Netlify variables. NEVER prefix these with VITE_.
# Copy project_id, client_email, and private_key from the existing service-account JSON.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Cloudinary: server-only. Never use VITE_ prefixes for these values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
