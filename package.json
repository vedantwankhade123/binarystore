{
  "name": "ecommerce-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run server:check && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-shopsphere --only firestore,auth \"node --test --test-concurrency=1 tests/firebase/rules.test.mjs\"",
    "dev:emulator": "vite --mode emulator --host 127.0.0.1",
    "firebase:check": "node scripts/checkFirebase.mjs",
    "firebase:seed": "node scripts/seedDemoProducts.mjs",
    "emulators": "firebase emulators:start --project demo-shopsphere --only auth,firestore",
    "test:firebase": "firebase emulators:exec --project demo-shopsphere --only firestore,auth \"node --experimental-strip-types --test --test-concurrency=1 tests/firebase/*.test.mjs\"",
    "check:frontend-secrets": "node scripts/checkFrontendSecrets.mjs",
    "server:check": "tsc -p tsconfig.server.json",
    "dev:netlify": "netlify dev --offline",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "cloudinary": "^2.11.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.34.1",
    "netlify-cli": "^27.15.0",
    "oxlint": "^1.89.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "@opentelemetry/core": "^2.8.0",
    "uuid": "^11.1.1"
  }
}
